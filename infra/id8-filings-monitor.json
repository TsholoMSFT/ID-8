{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "ID-8 filings watcher Logic App. On a recurrence, calls the app's own /api/filings-feeds?live=1 endpoint (real SEC EDGAR full-text + JSE/SENS, merged & deduped) for a watchlist of companies and writes the JSON into the 'filings' blob container as '{company}-filings-<timestamp>.json', which the api/filings-feeds function serves as a warm cache (with the same live path as fallback). Hardened with exponential HTTP retry, an action timeout, and a dead-letter scope that records failures to the 'filings-errors' container. REUSES the existing 'azureblob' API connection already authorized for id8-rss-monitor, so no new connection/secret is required."
  },
  "parameters": {
    "appBaseUrl": {
      "type": "string",
      "metadata": { "description": "Canonical ID-8 Static Web App HTTPS origin." }
    },
    "companies": {
      "type": "array",
      "defaultValue": [
        "Microsoft",
        "MTN Group",
        "Standard Bank",
        "Naspers",
        "Vodacom",
        "Sasol",
        "Shoprite Holdings",
        "Discovery Limited",
        "Absa Group"
      ],
      "metadata": { "description": "Watchlist of companies to pre-cache filings for. Editable in the portal." }
    },
    "location": {
      "type": "string",
      "defaultValue": "northcentralus",
      "metadata": { "description": "Must match the region of the reused azureblob API connection." }
    },
    "blobConnectionId": {
      "type": "string",
      "defaultValue": "/subscriptions/78d2ff46-2b11-4389-b9dd-6a5fd684e326/resourceGroups/rg-tsetati/providers/Microsoft.Web/connections/azureblob"
    },
    "blobApiId": {
      "type": "string",
      "defaultValue": "/subscriptions/78d2ff46-2b11-4389-b9dd-6a5fd684e326/providers/Microsoft.Web/locations/northcentralus/managedApis/azureblob"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "id8-filings-monitor",
      "location": "[parameters('location')]",
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "appBaseUrl": { "type": "String" },
            "$connections": { "type": "Object", "defaultValue": {} },
            "companies": { "type": "Array", "defaultValue": [] }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": { "frequency": "Hour", "interval": 12 }
            }
          },
          "actions": {
            "For_Each_Company": {
              "type": "Foreach",
              "foreach": "@parameters('companies')",
              "runtimeConfiguration": { "concurrency": { "repetitions": 3 } },
              "actions": {
                "Fetch_And_Store_Filings": {
                  "type": "Scope",
                  "actions": {
                    "HTTP": {
                      "type": "Http",
                      "limit": { "timeout": "PT3M" },
                      "inputs": {
                        "method": "GET",
                        "uri": "@{parameters('appBaseUrl')}/api/filings-feeds?company=@{encodeUriComponent(items('For_Each_Company'))}&live=1",
                        "headers": { "Accept": "application/json" },
                        "retryPolicy": { "type": "exponential", "count": 4, "interval": "PT20S", "maximumInterval": "PT1H" }
                      }
                    },
                    "Create_blob": {
                      "type": "ApiConnection",
                      "runAfter": { "HTTP": ["Succeeded"] },
                      "inputs": {
                        "host": {
                          "connection": { "name": "@parameters('$connections')['azureblob']['connectionId']" }
                        },
                        "method": "post",
                        "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent('AccountNameFromSettings'))}/files",
                        "queries": {
                          "folderPath": "/filings",
                          "name": "@{replace(toLower(items('For_Each_Company')), ' ', '-')}-filings-@{utcNow('yyyy-MM-dd-HH-mm')}.json",
                          "queryParametersSingleEncoded": true
                        },
                        "body": "@body('HTTP')",
                        "headers": { "ReadFileMetadataFromServer": true }
                      },
                      "runtimeConfiguration": { "contentTransfer": { "transferMode": "Chunked" } }
                    }
                  }
                },
                "Write_Error_Record": {
                  "type": "ApiConnection",
                  "runAfter": { "Fetch_And_Store_Filings": ["Failed", "TimedOut", "Skipped"] },
                  "inputs": {
                    "host": {
                      "connection": { "name": "@parameters('$connections')['azureblob']['connectionId']" }
                    },
                    "method": "post",
                    "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent('AccountNameFromSettings'))}/files",
                    "queries": {
                      "folderPath": "/filings-errors",
                      "name": "@{replace(toLower(items('For_Each_Company')), ' ', '-')}-error-@{utcNow('yyyy-MM-dd-HH-mm')}.json",
                      "queryParametersSingleEncoded": true
                    },
                    "body": "@{string(result('Fetch_And_Store_Filings'))}",
                    "headers": { "ReadFileMetadataFromServer": true }
                  },
                  "runtimeConfiguration": { "contentTransfer": { "transferMode": "Chunked" } }
                }
              }
            }
          }
        },
        "parameters": {
          "appBaseUrl": { "value": "[parameters('appBaseUrl')]" },
          "$connections": {
            "value": {
              "azureblob": {
                "connectionId": "[parameters('blobConnectionId')]",
                "connectionName": "azureblob",
                "id": "[parameters('blobApiId')]"
              }
            }
          },
          "companies": { "value": "[parameters('companies')]" }
        }
      }
    }
  ],
  "outputs": {
    "workflowName": { "type": "string", "value": "id8-filings-monitor" }
  }
}
