{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/assets/*", "*.{css,js,svg,png,jpg,jpeg,gif,ico,woff,woff2}"]
  },
  "routes": [
    { "route": "/.auth/login/github", "statusCode": 404 },
    { "route": "/api/health", "methods": ["GET", "OPTIONS"], "allowedRoles": ["anonymous"] },
    { "route": "/api/ai-readiness", "methods": ["GET", "OPTIONS"], "allowedRoles": ["anonymous"] },
    { "route": "/api/rss-feeds", "methods": ["GET", "OPTIONS"], "allowedRoles": ["anonymous"] },
    { "route": "/api/filings-feeds", "methods": ["GET", "OPTIONS"], "allowedRoles": ["anonymous"] },
    { "route": "/api/regulatory-feeds", "methods": ["GET", "OPTIONS"], "allowedRoles": ["anonymous"] },
    { "route": "/api/questionnaire/*", "methods": ["GET", "POST", "OPTIONS"], "allowedRoles": ["anonymous"] },
    {
      "route": "/api/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "platform": { "apiRuntime": "node:22" },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html"
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.openai.azure.com https://*.openai.azure.us https://*.openai.azure.cn https://*.cognitiveservices.azure.us https://*.cognitiveservices.azure.cn https://api.openai.com https://news.google.com;"
  }
}
