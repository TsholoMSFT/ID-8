{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Exception",
        "maxTelemetryItemsPerSecond": 2
      }
    },
    "logLevel": {
      "Host.Results": "Warning",
      "Function.health": "Warning",
      "Function.ai-readiness": "Warning"
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  }
}
